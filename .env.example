# Generate separate random values; never commit real tokens.
AWG_CLIENT_TOKEN=replace-with-a-random-secret-of-at-least-24-characters
AWG_UPSTREAM_TOKEN=replace-with-a-different-upstream-bearer-token
AWG_UPSTREAM_MCP_URL=http://127.0.0.1:3790/mcp
AWG_LISTEN_HOST=127.0.0.1
AWG_LISTEN_PORT=3791
# Optional: existing Fleet project alias dedicated to unrelated/general work.
# Without this, task delegation requires one authorized upstream scratch default.
# Do NOT use the pilot alias as an implicit destination for marketing/client tasks.
# AWG_GENERAL_PROJECT=general-work
# Existing operator-owned directory; omitted means workspace tools fail closed.
# AWG_WORKSPACE_ROOT=/path/to/an/existing/operator-owned/root
